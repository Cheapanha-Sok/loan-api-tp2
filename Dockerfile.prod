# Production image for the loan API (Lesson 4.6): multi-stage, slim, non-root, health-checked

# ---------- Stage 1: builder (installs packages, trains the model) ----------
FROM python:3.12-slim AS builder
WORKDIR /build
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY train.py .
RUN python train.py --out /build/model.joblib

# ---------- Stage 2: runtime (only what runs is shipped) ----------
FROM python:3.12-slim
# Apply Debian security updates that are newer than the base image (e.g. zlib1g, CVE-2026-85091)
RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 10001 appuser
WORKDIR /app
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MODEL_PATH=/app/model.joblib
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /build/model.joblib ./model.joblib
COPY main.py schemas.py ./
USER appuser
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)" || exit 1
CMD ["fastapi", "run", "main.py", "--port", "8000"]
